# ==============================================================================
# NEXORA DevHub — Production & Environment Variable Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Configure these variables in the Vercel Project Settings > Environment Variables for production.
# NEVER commit .env, .env.local, or real production credentials to Git.
# ==============================================================================

# ── 1. DATABASE (Neon Serverless PostgreSQL) ──────────────────────────────────
# [REQUIRED FOR PRODUCTION]
# Pooled connection string with connection pooling enabled (e.g., PgBouncer endpoint).
# Used by Next.js Server Actions and Prisma Client runtime queries.
DATABASE_URL="postgresql://user:password@ep-your-database-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# [REQUIRED FOR PRODUCTION]
# Direct connection string bypassing pooler.
# Required for running Prisma migrations safely ('prisma migrate deploy') during deployment.
DIRECT_URL="postgresql://user:password@ep-your-database.region.aws.neon.tech/neondb?sslmode=require"

# ── 2. AUTHENTICATION (Auth.js v5 / NextAuth) ─────────────────────────────────
# [REQUIRED FOR PRODUCTION]
# Cryptographic secret used to sign and encrypt JWT session cookies.
# Generate a secure 32-byte string using: openssl rand -base64 32
AUTH_SECRET="generate-a-secure-random-32-byte-secret"

# [REQUIRED FOR PRODUCTION]
# Canonical public base URL of the deployed application (HTTPS in production).
# In Vercel, this is automatically configured or maps to your custom domain.
AUTH_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# ── 3. TRANSACTIONAL EMAIL (Resend) ───────────────────────────────────────────
# [REQUIRED FOR PRODUCTION IF EMAIL VERIFICATION & PASSWORD RESET ENABLED]
# API key obtained from Resend dashboard (https://resend.com/api-keys).
# When omitted, the app safely logs simulation in dev or gracefully reports unavailable in prod.
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"

# [REQUIRED FOR PRODUCTION IF RESEND_API_KEY CONFIGURED]
# Verified sending email address or custom domain address.
EMAIL_FROM="NEXORA DevHub <noreply@yourdomain.com>"

# ── 4. OAUTH PROVIDERS (Optional) ─────────────────────────────────────────────
# [OPTIONAL INTEGRATION: GitHub OAuth]
# Configure GitHub OAuth App at: https://github.com/settings/developers
# Authorization callback URL: https://your-domain.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Alternative standard variable names also supported:
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# [OPTIONAL INTEGRATION: Google OAuth]
# Configure Google Cloud Console OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://your-domain.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Alternative standard variable names also supported:
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ── 5. DEVELOPMENT & TESTING ONLY (Forbidden in Production) ───────────────────
# [DEVELOPMENT ONLY]
# Never set to true in production. Automatically disabled when NODE_ENV === "production".
ALLOW_DEMO_FALLBACK="false"

# [DEVELOPMENT ONLY]
# Simulates email dispatch to console terminal without calling external email API.
ENABLE_EMAIL_SIMULATION="false"
